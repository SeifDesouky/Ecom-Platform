{
  "info": {
    "name": "EcomPlatform API v1.0",
    "description": "EcomPlatform Backend API — Complete Collection\nBase URL: http://localhost:5054/api/v1\n\n كيفية الاستخدام:\n1. شغل 'Login' الأول\n2. الـ token هيتحفظ تلقائياً في الـ collection variables\n3. كل الـ requests المحتاجة Auth هتستخدمه تلقائياً",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5054/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "tenantId", "value": "414e3a90-0d35-44b0-b0ca-fd0ce3879fe8", "type": "string" },
    { "key": "userId", "value": "d4bc9709-25b6-41d5-bb88-cda0340efca2", "type": "string" },
    { "key": "productId", "value": "c8e1b92d-f23d-442b-ada9-baf8323981e8", "type": "string" },
    { "key": "categoryId", "value": "5eb4ee03-b0cc-4511-b62a-47161eb5ec5d", "type": "string" },
    { "key": "orderId", "value": "d6351408-65c7-48b8-acab-8575b8df18e9", "type": "string" },
    { "key": "invoiceId", "value": "54061476-a671-4b8d-841d-68d10e5b63d9", "type": "string" },
    { "key": "customerId", "value": "30c2ad6f-9ff2-436c-8ca7-5f8546d0ae40", "type": "string" },
    { "key": "planId", "value": "018ccf0a-9210-4a9c-b40e-8987f30daf2f", "type": "string" },
    { "key": "ticketId", "value": "17275abb-7b6c-41ae-839b-8f506037c053", "type": "string" },
    { "key": "resetToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": " Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"test@newuser.com\",\n  \"phone\": \"01200000000\",\n  \"password\": \"Test@1234\"\n}" },
            "description": " Expected: role = TenantAdmin تلقائياً حتى لو بعتت SuperAdmin"
          }
        },
        {
          "name": "Login (Ahmed - TenantAdmin)",
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.success) {", "  pm.collectionVariables.set('token', json.data.token);", "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);", "  console.log('✅ Token saved automatically');", "}"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"NewPass@1234\"\n}" },
            "description": " Token يتحفظ تلقائياً في الـ collection variables"
          }
        },
        {
          "name": "Login (SuperAdmin)",
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.success) {", "  pm.collectionVariables.set('token', json.data.token);", "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);", "  console.log('✅ SuperAdmin token saved');", "}"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@platform.io\",\n  \"password\": \"Admin@12345!\"\n}" },
            "description": " Expected: role = SuperAdmin"
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.success) {", "  pm.collectionVariables.set('token', json.data.token);", "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);", "}"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "description": " Token جديد + القديم بيتلغى\n Security: لو بعتت الـ token القديم تاني → Security alert + كل Sessions تتلغى"
          }
        },
        {
          "name": "Get Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/sessions", "host": ["{{baseUrl}}"], "path": ["auth", "sessions"] },
            "description": " Expected: list of active sessions مع deviceInfo و ipAddress"
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/revoke", "host": ["{{baseUrl}}"], "path": ["auth", "revoke"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/revoke-all", "host": ["{{baseUrl}}"], "path": ["auth", "revoke-all"] },
            "description": " Expected: كل الـ sessions تتلغى"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed@test.com\"\n}" },
            "description": " No Auth Required\n بيبعت reset link على الـ email\n مش بيقول لو الـ email مش موجود (security)"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPass@1234\"\n}" },
            "description": " No Auth Required\n بيغير الـ password ويلغي كل الـ sessions\n احتاج تجيب الـ token من DB أو من الـ email"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\"\n}" },
            "description": " No Auth Required\n بيعمل IsEmailVerified = true للـ user"
          }
        },
        {
          "name": " Rate Limit Test (ابعت 6 مرات بسرعة)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"WrongPass123\"\n}" },
            "description": " ابعت الـ request ده 6 مرات بسرعة\n Expected: الـ 6th يرجع 429 Too Many Requests"
          }
        }
      ]
    },
    {
      "name": " Tenants",
      "item": [
        {
          "name": "Get All Tenants (SuperAdmin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tenants", "host": ["{{baseUrl}}"], "path": ["tenants"] },
            "description": " SuperAdmin فقط"
          }
        },
        {
          "name": "Get Tenant by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tenants/{{tenantId}}", "host": ["{{baseUrl}}"], "path": ["tenants", "{{tenantId}}"] }
          }
        },
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/tenants", "host": ["{{baseUrl}}"], "path": ["tenants"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"متجر جديد\",\n  \"slug\": \"new-store-test\",\n  \"email\": \"newstore@test.com\",\n  \"phone\": \"01100000000\",\n  \"logo\": \"\",\n  \"domain\": \"newstore.com\",\n  \"subscriptionEndDate\": \"2027-01-01T00:00:00Z\"\n}" }
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/tenants/{{tenantId}}", "host": ["{{baseUrl}}"], "path": ["tenants", "{{tenantId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"متجر احمد المحدث\",\n  \"email\": \"store@ahmed.com\",\n  \"phone\": \"01000000000\"\n}" }
          }
        },
        {
          "name": "Toggle Tenant Status",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/tenants/{{tenantId}}/toggle-status", "host": ["{{baseUrl}}"], "path": ["tenants", "{{tenantId}}", "toggle-status"] }
          }
        }
      ]
    },
    {
      "name": " Products",
      "item": [
        {
          "name": "Get Products (Paginated)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?pageNumber=1&pageSize=10", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "pageNumber", "value": "1" }, { "key": "pageSize", "value": "10" }] }
          }
        },
        {
          "name": "Get Products by Tenant (SuperAdmin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/tenant/{{tenantId}}", "host": ["{{baseUrl}}"], "path": ["products", "tenant", "{{tenantId}}"] },
