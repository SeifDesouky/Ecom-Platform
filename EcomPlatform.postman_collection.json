    {
      "name": " Orders",
      "item": [
        {
          "name": "Get Orders by Tenant",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders/tenant/{{tenantId}}", "host": ["{{baseUrl}}"], "path": ["orders", "tenant", "{{tenantId}}"] }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"customerName\": \"تيست كاستومر\",\n  \"customerEmail\": \"order@test.com\",\n  \"customerPhone\": \"01000000000\",\n  \"shippingAddress\": \"123 Test St\",\n  \"shippingCity\": \"القاهرة\",\n  \"shippingCountry\": \"مصر\",\n  \"shippingPhone\": \"01000000000\",\n  \"shippingCost\": 50,\n  \"discount\": 0,\n  \"tax\": 0,\n  \"notes\": \"\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1,\n      \"unitPrice\": 25000\n    }\n  ]\n}" },
            "description": " Stock validation عند الإنشاء\n Stock يتخصم بعد الدفع (UpdatePaymentStatus → Paid)"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": 2\n}" },
            "description": "Status: 1=Pending, 2=Processing, 3=Shipped, 4=Delivered, 5=Cancelled"
          }
        },
        {
          "name": "Update Payment Status (Stock يتخصم هنا)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment-status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "payment-status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": 2\n}" },
            "description": " لما PaymentStatus = Paid (2) → Stock يتخصم تلقائياً\nStatus: 1=Pending, 2=Paid, 3=Failed, 4=Refunded"
          }
        },
        {
          "name": "Cancel Order (Stock يرجع لو Paid)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "cancel"] },
            "description": " Stock يرجع بس لو الـ order كان Paid\n لو Delivered مش ممكن يتلغى"
          }
        },
        {
          "name": " Insufficient Stock Test",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"customerName\": \"تيست\",\n  \"customerEmail\": \"test@test.com\",\n  \"customerPhone\": \"01000000000\",\n  \"shippingAddress\": \"Test\",\n  \"shippingCity\": \"القاهرة\",\n  \"shippingCountry\": \"مصر\",\n  \"shippingPhone\": \"01000000000\",\n  \"shippingCost\": 50,\n  \"discount\": 0,\n  \"tax\": 0,\n  \"notes\": \"\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 9999,\n      \"unitPrice\": 25000\n    }\n  ]\n}" },
            "description": " Expected: Insufficient stock error"
          }
        }
