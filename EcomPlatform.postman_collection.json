            "body": { "mode": "raw", "raw": "{\n  \"name\": \"تصنيف جديد\",\n  \"slug\": \"new-category\",\n  \"description\": \"وصف التصنيف\",\n  \"tenantId\": \"{{tenantId}}\"\n}" }
