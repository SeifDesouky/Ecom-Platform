            "body": { "mode": "raw", "raw": "{\n  \"name\": \"منتج جديد\",\n  \"slug\": \"new-product\",\n  \"description\": \"وصف المنتج\",\n  \"price\": 1500,\n  \"stock\": 10,\n  \"categoryId\": \"{{categoryId}}\",\n  \"tenantId\": \"{{tenantId}}\",\n  \"isActive\": true\n}" }
          }
