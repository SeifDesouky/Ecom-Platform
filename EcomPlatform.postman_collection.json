            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"price\": -100,\n  \"slug\": \"INVALID SLUG\"\n}" },
            "description": " Expected: 400 Bad Request + Arabic validation errors"
          }
        }
      ]
    },
